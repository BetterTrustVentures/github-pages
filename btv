        function addToCart(itemId, sourceArray) {
            const item = sourceArray.find(service => service.id === itemId);
            if (!item) {
                console.error('Item not found in source array:', itemId, sourceArray);
                alertMessage('Error: Item not found. Please try again.');
                return;
            }

            const existingCartItem = shoppingCart.find(cartItem => cartItem.id === itemId);

