                currentEssayText = event.target.value;
                // Re-render the button state (enabled/disabled)
                const feedbackBtn = document.getElementById('get-essay-feedback-btn');
                if (feedbackBtn) {
                    if (isFeedbackGenerating || currentEssayText.split(' ').length < 10) {
                        feedbackBtn.setAttribute('disabled', 'true');
                        feedbackBtn.classList.add('opacity-50', 'cursor-not-allowed');
                    } else {
                        feedbackBtn.removeAttribute('disabled');
                        feedbackBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    }
                }
            });

            document.getElementById('get-essay-feedback-btn').addEventListener('click', generateEssayFeedback);
        }

        /**
         * Handles the conceptual submission of the grant application form.
         * In a real application, this would send data to a backend.
         * @param {Event} event - The form submission event.
         */
        function handleGrantApplicationSubmit(event) {
