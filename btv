                                          return item ? `${item.name} ($${item.price.toFixed(2)})` : `Unknown Item (ID: ${checkbox.value})`;
                                      });

            console.log("Grant Application Submitted:");
            console.log("Name:", applicantName);
            console.log("Email:", applicantEmail);
            console.log("Selected Items:", selectedItems);
            console.log("Why Deserve Grant:", whyDeserveGrant);

            alertMessage(`Thank you, ${applicantName}! Your grant application has been submitted. We will review it within 6-8 weeks and notify you via email.`);

            // Optionally clear the form
