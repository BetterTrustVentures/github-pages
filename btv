        let selectedConsultationDate = null;
        let selectedConsultationTime = null;
        let selectedConsultationType = 'standard'; // 'standard' or 'priority'

        // Helper to get a date two weeks from now
        function getEarliestConsultationDate() {
            const today = new Date();
            today.setDate(today.getDate() + 14); // 2 weeks out
            return today;
        }

        function generateCalendar(year, month) {
            const firstDay = new Date(year, month, 1);
            const lastDay = new Date(year, month + 1, 0);
            const today = new Date();
            const earliestBookingDate = getEarliestConsultationDate();

            let calendarHtml = '<div class="grid grid-cols-7 gap-1 text-xs sm:text-sm font-semibold text-gray-700 mb-2">';
            const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
            dayNames.forEach(day => {
                calendarHtml += `<div class="text-center">${day}</div>`;
            });
            calendarHtml += '</div>';

            calendarHtml += '<div class="grid grid-cols-7 gap-1">';
            // Fill leading empty days
            for (let i = 0; i < firstDay.getDay(); i++) {
                calendarHtml += '<div class="p-2"></div>';
            }

            for (let day = 1; day <= lastDay.getDate(); day++) {
                const currentDate = new Date(year, month, day);
                // Ensure date comparison is accurate by setting hours to 0 for both dates
                const normalizedCurrentDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), currentDate.getDate());
                const normalizedEarliestBookingDate = new Date(earliestBookingDate.getFullYear(), earliestBookingDate.getMonth(), earliestBookingDate.getDate());
                const normalizedToday = new Date(today.getFullYear(), today.getMonth(), today.getDate());

                const isToday = normalizedCurrentDate.toDateString() === normalizedToday.toDateString();
                const isSelectable = normalizedCurrentDate >= normalizedEarliestBookingDate || isToday;
                const isSelected = selectedConsultationDate && normalizedCurrentDate.toDateString() === new Date(selectedConsultationDate.getFullYear(), selectedConsultationDate.getMonth(), selectedConsultationDate.getDate()).toDateString();


                let dayClasses = `p-2 rounded-md text-center cursor-pointer transition-colors duration-200`;
                if (isSelected) {
                    dayClasses += ` bg-blue-600 text-white`;
                } else if (!isSelectable) {
                    dayClasses += ` bg-gray-100 text-gray-400 cursor-not-allowed`;
                } else {
                    dayClasses += ` bg-white hover:bg-blue-100 text-gray-800`;
                }

                calendarHtml += `
                    <div class="${dayClasses}" data-date="${currentDate.toISOString().split('T')[0]}" ${isSelectable ? 'data-selectable="true"' : 'data-selectable="false"'}>
                        ${day}
                    </div>
                `;
            }
            calendarHtml += '</div>';
            return calendarHtml;
        }

