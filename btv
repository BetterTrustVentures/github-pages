        // --- Accessibility Functions ---

        /**
         * Applies or removes accessibility classes to the body.
         */
        function applyAccessibilitySettings() {
            const body = document.body;

            // Remove all existing accessibility classes first to prevent conflicts
            body.classList.remove('grayscale-mode', 'high-contrast-mode', 'font-size-large', 'font-size-xl', 'font-size-xxl');

            // Apply Grayscale
            if (isGrayscaleActive) {
                body.classList.add('grayscale-mode');
            }

            // Apply High Contrast (this will override some colors, so order matters)
            if (isHighContrastActive) {
                body.classList.add('high-contrast-mode');
            }

            // Apply Font Size
            if (fontSizeLevel === 1) {
                body.classList.add('font-size-large');
            } else if (fontSizeLevel === 2) {
                body.classList.add('font-size-xl');
            } else if (fontSizeLevel === 3) {
                body.classList.add('font-size-xxl');
            }
        }

        /**
         * Toggles grayscale mode.
         */
        function toggleGrayscale() {
            isGrayscaleActive = !isGrayscaleActive;
            applyAccessibilitySettings();
            alertMessage(`Grayscale mode ${isGrayscaleActive ? 'activated' : 'deactivated'}.`);
        }

        /**
         * Toggles high contrast mode.
         */
        function toggleHighContrast() {
            isHighContrastActive = !isHighContrastActive;
            applyAccessibilitySettings();
            alertMessage(`High contrast mode ${isHighContrastActive ? 'activated' : 'deactivated'}.`);
        }

        /**
         * Increases font size in steps.
         */
        function increaseFontSize() {
            if (fontSizeLevel < 3) {
                fontSizeLevel++;
                applyAccessibilitySettings();
                alertMessage(`Font size increased (Level ${fontSizeLevel}).`);
            } else {
                alertMessage("Maximum font size reached.");
            }
        }

        /**
         * Decreases font size in steps.
         */
        function decreaseFontSize() {
            if (fontSizeLevel > 0) {
                fontSizeLevel--;
                applyAccessibilitySettings();
                alertMessage(`Font size decreased (Level ${fontSizeLevel}).`);
            } else {
                alertMessage("Minimum font size reached (Normal).");
            }
        }

        /**
         * Resets all accessibility settings.
         */
        function resetAccessibility() {
            isGrayscaleActive = false;
            isHighContrastActive = false;
            fontSizeLevel = 0;
            applyAccessibilitySettings();
            alertMessage("All accessibility settings reset to default.");
        }

