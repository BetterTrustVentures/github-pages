            currentLLMFeedback = ""; // Clear feedback
            renderScholarshipGrantPage(); // Re-render to clear LLM feedback display
        }

        /**
         * Generates essay feedback using the Gemini API.
         */
        async function generateEssayFeedback() {
            if (currentEssayText.split(' ').length < 10) {
                alertMessage("Please write at least 10 words in your essay to get feedback.");
                return;
            }

            isFeedbackGenerating = true;
            currentLLMFeedback = ""; // Clear previous feedback
            renderScholarshipGrantPage(); // Re-render to show loading state

            try {
                const prompt = `Review the following essay submitted for a grant application. Provide constructive feedback on its clarity, persuasiveness, completeness, and any suggestions for improvement. Keep the feedback concise and actionable.

Essay:
"${currentEssayText}"`;

                let chatHistory = [];
                chatHistory.push({ role: "user", parts: [{ text: prompt }] });
                const payload = { contents: chatHistory };
                const apiKey = ""; // If you want to use models other than gemini-2.0-flash or imagen-3.0-generate-002, provide an API key here. Otherwise, leave this as-is.
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${apiKey}`;

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (result.candidates && result.candidates.length > 0 &&
                    result.candidates[0].content && result.candidates[0].content.parts &&
                    result.candidates[0].content.parts.length > 0) {
                    const text = result.candidates[0].content.parts[0].text;
                    currentLLMFeedback = text;
                } else {
                    currentLLMFeedback = "Could not generate feedback. Please try again.";
                }
            } catch (error) {
                console.error("Error generating feedback:", error);
                currentLLMFeedback = "An error occurred while generating feedback. Please try again.";
            } finally {
                isFeedbackGenerating = false;
                renderScholarshipGrantPage(); // Re-render to show feedback or error
            }
        }


