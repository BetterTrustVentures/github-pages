        /**
         * Calculates the base total cost of items in the shopping cart (before discount).
         * @returns {number} The base total cost.
         */
        function calculateBaseCartTotal() {
            return shoppingCart.reduce((total, item) => total + (item.price * item.quantity), 0);
        }

        /**
         * Calculates the final total cost including any applied discount.
         * @returns {number} The final total cost.
         */
        function calculateFinalCartTotal() {
            const baseTotal = calculateBaseCartTotal();
            return baseTotal * (1 - appliedDiscount);
        }

